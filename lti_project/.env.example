# ==============================================================================
# TCC Discussion Hub - Environment Configuration
# ==============================================================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
BASE_URL=https://discussionhub.tccd.edu

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://discussionhub:CHANGE_THIS_PASSWORD@localhost:5432/discussionhub

# ------------------------------------------------------------------------------
# Session Security
# ------------------------------------------------------------------------------
# Generate a secure random string: openssl rand -hex 32
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_HEX_STRING

# ------------------------------------------------------------------------------
# LTI 1.3 Configuration
# ------------------------------------------------------------------------------
# These values come from Canvas after creating the Developer Key
# See Canvas_LTI_Setup_Guide.md for instructions

# Client ID from Canvas Developer Key (e.g., 10000000000123)
LTI_CLIENT_ID=

# Your Canvas instance URL
LTI_PLATFORM_URL=https://tccd.instructure.com

# Canvas OAuth endpoints (typically don't need to change for standard Canvas)
LTI_AUTH_URL=https://tccd.instructure.com/api/lti/authorize_redirect
LTI_TOKEN_URL=https://tccd.instructure.com/login/oauth2/token
LTI_KEYSET_URL=https://tccd.instructure.com/api/lti/security/jwks

# ------------------------------------------------------------------------------
# File Storage
# ------------------------------------------------------------------------------
UPLOAD_DIR=/var/www/discussionhub/uploads
MAX_FILE_SIZE=104857600
# MAX_FILE_SIZE is in bytes: 104857600 = 100MB

# ------------------------------------------------------------------------------
# Optional: Logging
# ------------------------------------------------------------------------------
# LOG_LEVEL=info
# LOG_DIR=/var/www/discussionhub/logs
